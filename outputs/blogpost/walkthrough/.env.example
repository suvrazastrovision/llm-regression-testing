# Copy this file to .env, then replace the placeholder with your own key.
OPENAI_API_KEY=your_api_key_here
# Same default model as the pasted example. These models must be available to your account.
LLM_MODEL=gpt-4o-mini
# Keep the judge fixed when changing the model or prompts being tested.
JUDGE_MODEL=gpt-4o-mini

# Langfuse project settings > API Keys. Use your project's region or self-hosted URL.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
